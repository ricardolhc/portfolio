# Optional: real production URL including repository path, without trailing slash.
# Leave unset until the destination exists; no canonical/sitemap URL is guessed.
VITE_SITE_URL=
# / for root hosting; /repository-name/ for a project on GitHub Pages.
VITE_BASE_PATH=/

# Formspree uses the public endpoint in src/config/contact.ts.
# No environment variable or secret is required for form moeeapay.
